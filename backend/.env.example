# ============================
# Servidor
# ============================
PORT=4000
NODE_ENV=development

# URL del frontend (para CORS). En producción poné la URL real de Vercel/tu dominio.
FRONTEND_URL=http://localhost:3000

# ============================
# Supabase
# ============================
# Los encontrás en tu proyecto de Supabase > Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# OJO: la SERVICE ROLE KEY tiene permisos totales. NUNCA la expongas en el frontend,
# solo se usa acá en el backend.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Nombres de los buckets de Storage (creados por schema.sql)
SUPABASE_VEHICLES_BUCKET=vehicles
SUPABASE_CONSIGNMENTS_BUCKET=consignments

# ============================
# Auth (backoffice)
# ============================
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Datos para crear el primer usuario admin con "npm run create-admin"
ADMIN_NAME="Administrador Degra"
ADMIN_EMAIL=admin@degraautomotores.com
ADMIN_PASSWORD=CambiarEsteClave123!
